---
import SpellCardLayout from "../../layouts/SpellCardLayout.astro";
import { type CollectionEntry } from "astro:content";

const characterSpellNameList: CollectionEntry<"spells">["data"]["spell"][0]["name"][] =
  [
    // Cantrips: 2 + 1 (tinker's magic) + 1 gnome
    "Mending", // tinker's magic & gnome
    "Prestidigitation", // gnome
    "Fire Bolt",
    "Guidance",
    // artillerist
    "Shield",
    "Thunderwave",
    "Scorching Ray",
    "Shatter",
    "Fireball",
    "Wind Wall",
    // prepared: 9 + 2 (artillerist)
    "Faerie Fire",
    "Cure Wounds",
    "Grease",
    "Fly",
    "Blink",
    "Web",
    "Invisibility",
    "Enlarge/Reduce",
    "Dragon's Breath",
  ];
---

<SpellCardLayout
  characterSpellNameList={characterSpellNameList}
  characterName="Merrik"
/>
